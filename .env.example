# 复制为 .env.local 后填入实际值

# ─── AI 解读（只给服务端 /api/interpret 用）───
# 排盘不需要任何 Key。不要写成 NEXT_PUBLIC_，不要提交 .env.local。
# /api/interpret 只读取下面三个变量，不读取 MIMO_*。
DEEPSEEK_API_KEY=your-deepseek-api-key
# 可选。默认 https://api.deepseek.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选。默认 deepseek-flash（官方经济档，思考模式由接口关闭）。
# deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用。
# DEEPSEEK_MODEL=deepseek-flash

# ─── 其他 OpenAI 兼容模型：当前 /api/interpret 不会使用 ───
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
